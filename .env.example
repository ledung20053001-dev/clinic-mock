# Mock auth (per session requirement): each API_KEY is a separate tenant.
# Comma-separated `tenant_id:sk_...` pairs. Every key grants full tenant access.
MOCK_API_KEYS=tenant_demo:sk_dev_demo,tenant_acme:sk_acme_live

# Seed dataset (README "Seed Data"). Empty DATA_DIR serves the packaged dataset;
# PROFILES adds optional rows on top of the stock seed (e.g. base,demo).
MOCK_SEED_DATA_DIR=
MOCK_SEED_PROFILES=base
MOCK_SEED_HORIZON_DAYS=21
