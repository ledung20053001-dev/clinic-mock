# Application
APP_PROJECT_NAME=clinic-mock
APP_VERSION=1.0.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_JSON_LOGS=false

# Langfuse (per APIs.md §14.1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=sandbox
LANGFUSE_TRACES_ENABLED=true

